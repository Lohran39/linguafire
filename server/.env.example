# ============================================
# CONFIGURAÇÃO DO LINGUAFIRE
# ============================================

# Porta do servidor
PORT=3000

# Host do servidor:
# local seguro: 127.0.0.1
# deploy/VPS/Railway/Render: 0.0.0.0
HOST=127.0.0.1

# ============================================
# SUPABASE
# ============================================
# O backend usa Supabase como banco principal.
# 1. Crie um projeto em https://supabase.com
# 2. Copie a URL e a key do projeto
# 3. Rode o SQL de migration no Supabase SQL Editor
# 4. Preencha as linhas abaixo:

SUPABASE_URL=https://seu-projeto.supabase.co

# Service role key para o BACKEND.
# NUNCA coloque essa chave no frontend, GitHub público ou app mobile.
# Gere em: Supabase Dashboard > Settings > API
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ============================================
# GOOGLE OAUTH (OPCIONAL)
# ============================================
# Para ativar login com Google:

# 1. Acesse: https://console.cloud.google.com/
# 2. Crie um novo projeto ou selecione um existente
# 3. Vá em "APIs e Serviços" > "Biblioteca"
# 4. Pesquise e ative "Google+ API"
# 5. Vá em "APIs e Serviços" > "Credenciais"
# 6. Clique em "Criar Credenciais" > "ID do cliente OAuth"
# 7. Configure:
#    - Tipo: Aplicação da Web
#    - Nome: LinguaFire
#    - URI de redirecionamento autorizado: http://localhost:3000/auth/google/callback
# 8. Copie o Client ID e Client Secret aqui:

GOOGLE_CLIENT_ID=seu-google-client-id-aqui
GOOGLE_CLIENT_SECRET=seu-google-client-secret-aqui

# ============================================
# SEGURANÇA - PRODUÇÃO
# ============================================
# Em produção, configure seu domínio real

# DOMÍNIO do seu site (sem trailing slash)
BASE_URL=https://seudominio.com

# Origins permitidas (separadas por vírgula, sem espaços)
# Inclua ambos versão com e sem www se aplicável
CORS_ORIGINS=https://seudominio.com,https://www.seudominio.com

# Ambiente (development ou production)
NODE_ENV=production

# JWT Secret - use uma string grande e aleatória em produção!
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=gere-uma-chave-com-o-comando-acima
JSON_BODY_LIMIT=1mb
ALLOW_DEV_RESET_LINK=false

# Use true apenas se quiser manter a assinatura simulada em produção.
# Para cobrança real, deixe false e implemente checkout/webhook.
ALLOW_FAKE_SUBSCRIPTIONS=false

# Stripe Checkout (necessario para assinatura real)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ============================================
# EMAIL / SMTP (OPCIONAL, recomendado)
# ============================================
# Necessário para enviar links reais de recuperação de senha.
# Deixe SMTP_HOST vazio para desativar envio de email.
# Em Gmail, use uma "Senha de app", não sua senha normal.
#
# Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=sua-senha-de-app
# SMTP_FROM=LinguaFire <seu-email@gmail.com>
#
# Resend:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_seu_api_key
# SMTP_FROM=LinguaFire <noreply@seu-dominio.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LinguaFire <noreply@linguafire.com>

# ============================================
# GEMINI OPENAI-COMPAT PROXY (OPCIONAL)
# ============================================
# Permite usar este backend como gateway OpenAI-compatible:
# POST http://127.0.0.1:3000/v1/chat/completions

GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL_ALIAS=gemini-3.6-flash
PROXY_TIMEOUT_MS=60000
AGENT_MAX_STEPS=8
AGENT_CMD_TIMEOUT_MS=15000
DEPLOY_CMD_TIMEOUT_MS=120000
AGENT_ADMIN_TOKEN=
LOG_HTTP_REQUESTS=false

# Tokens administrativos para gravar cache curado via API.
# Gere valores longos e aleatórios. Em produção, não deixe vazio.
NATIVES_ADMIN_TOKEN=
LYRICS_ADMIN_TOKEN=

# ============================================
# WEB PUSH NOTIFICATIONS (OPCIONAL)
# ============================================
# Para ativar notificações push:
# 1. npm install web-push
# 2. Generate VAPID keys: npx web-push generate-vapid-keys
# 3. Cole as chaves abaixo

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
PUSH_ADMIN_TOKEN=
